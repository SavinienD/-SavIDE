{
  "name": "axecode",
  "private": true,
  "version": "0.1.66",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "remote": "node remote/server.mjs",
    "build": "tsc --noEmit && vite build && npm run build:web",
    "build:web": "tsc --noEmit -p web && vite build --config web/vite.config.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "prepare-sidecars": "node scripts/prepare-sidecars.mjs && node scripts/prepare-python.mjs",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:conversation-actions": "node --test tests/actionsConversation.test.cjs",
    "test": "node --test tests/",
    "audit:affichage": "node scripts/audit-affichage/lancer.mjs"
  },
  "dependencies": {
    "@fontsource/geist-mono": "^5.3.0",
    "@fontsource/geist-sans": "^5.3.0",
    "@iconify-json/simple-icons": "^1.2.100",
    "@iconify-json/solar": "1.2.5",
    "@iconify-json/vscode-icons": "1.2.45",
    "@iconify/react": "6.0.2",
    "@monaco-editor/react": "^4.6.0",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-dialog": "^2.0.1",
    "@xterm/addon-clipboard": "0.3.0-beta.218",
    "@xterm/addon-fit": "0.12.0-beta.218",
    "@xterm/addon-unicode11": "0.10.0-beta.218",
    "@xterm/addon-web-links": "0.13.0-beta.218",
    "@xterm/addon-webgl": "0.20.0-beta.217",
    "@xterm/xterm": "6.1.0-beta.218",
    "highlight.js": "^11.10.0",
    "lucide-react": "1.8.0",
    "mammoth": "^1.13.0",
    "mermaid": "11.17.2",
    "monaco-editor": "^0.52.0",
    "pdfjs-dist": "^5.4.296",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.0.1",
    "rehype-highlight": "^7.0.1",
    "remark-gfm": "^4.0.0",
    "web-push": "3.6.7",
    "ws": "8.21.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "24.1.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
